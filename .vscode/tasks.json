{
  "version": "2.0.0",
  "tasks": [
    { "label": "nyac: compilar", "type": "shell", "command": "nyac", "args": ["build", "${fileDirname}"],
      "group": { "kind": "build", "isDefault": true }, "problemMatcher": {
        "owner": "nyansharp", "fileLocation": ["relative", "${fileDirname}"],
        "pattern": { "regexp": "^\\s*\\(>_<\\) (.+?):(\\d+):(\\d+)\\s+(CS\\d+): (.*)$",
                     "file": 1, "line": 2, "column": 3, "code": 4, "message": 5 } } },
    { "label": "nyac: compilar y ejecutar", "type": "shell", "command": "nyac", "args": ["run", "${fileDirname}"],
      "group": { "kind": "test", "isDefault": true }, "presentation": { "focus": true } }
  ]
}

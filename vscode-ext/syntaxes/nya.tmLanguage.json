{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NyanSharp",
  "scopeName": "source.nya",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "match": "\\b(onegai|oshiro|nakama|kokoro|yakusoku|erabimono)\\b", "name": "keyword.other.nya" },
    { "match": "\\b(minna|himitsu|mamoru|zutto|kawaranai|taisetsu|yume|kakikaeru|maboroshi|nonbiri|matte)\\b", "name": "storage.modifier.nya" },
    { "match": "\\b(nanimo|kazu|nagakazu|puchikazu|dekakazu|okane|kotoba|moji|hontou|mono|nanika)\\b", "name": "storage.type.nya" },
    { "match": "\\b(hai|iie|nai)\\b", "name": "constant.language.nya" },
    { "match": "\\b(moshi|janakya|aida|yaru|kurikaeshi|hitotsuzutsu|naka|erabu|baai|futsuu|yamete|tsuzukete|kaeru|ganbaru|daijoubu|owari|nageru)\\b", "name": "keyword.control.nya" },
    { "match": "\\b(atarashii|atashi|okaasan|desu|toshite|soto|sasu|nanikore|choudai|ageru)\\b", "name": "keyword.operator.nya" },
    { "match": "\\b(iu|sasayaku|kiku|hajimeru|sekai)\\b", "name": "support.function.nya" },
    { "match": "\\bnya\\b|~+", "name": "punctuation.terminator.nya entity.name.tag.nya" },
    { "match": "\\b[0-9]+(\\.[0-9]+)?[fFdDmML]?\\b", "name": "constant.numeric.nya" },
    { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.nya" }
  ],
  "repository": {
    "comments": { "patterns": [
      { "match": "//.*$", "name": "comment.line.double-slash.nya" },
      { "begin": "/\\*", "end": "\\*/", "name": "comment.block.nya" }
    ]},
    "strings": { "patterns": [
      { "begin": "\\$?@?\"", "end": "\"", "name": "string.quoted.double.nya",
        "patterns": [ { "match": "\\\\.", "name": "constant.character.escape.nya" },
                      { "begin": "\\{", "end": "\\}", "name": "meta.interpolation.nya", "patterns": [{ "include": "$self" }] } ] },
      { "match": "'(\\\\.|[^'])'", "name": "string.quoted.single.nya" }
    ]}
  }
}
